+#if defined(OEP_HOST_APP)
+	// OEP: the project folder is a normal directory holding the title's *.xp3
+	// archives.  KiriKiri 1.x mounted every archive in the project directory
+	// ("mount domain ..."), the current core does not, so register them here as
+	// auto paths.  data.xp3 comes first and patch archives last, so a patch wins
+	// for files that exist in both.
+	if (!projectPath.empty()) {
+		std::error_code ec;
+		const std::filesystem::path projectDir(projectPath);
+		if (std::filesystem::is_directory(projectDir, ec)) {
+			std::vector<std::filesystem::path> archives;
+			for (auto it = std::filesystem::directory_iterator(projectDir, ec);
+			     !ec && it != std::filesystem::directory_iterator(); it.increment(ec)) {
+				const std::filesystem::path &candidate = it->path();
+				std::string extension = candidate.extension().string();
+				for (char &ch : extension) ch = (char)std::tolower((unsigned char)ch);
+				if (extension != ".xp3") continue;
+				std::error_code fileEc;
+				if (std::filesystem::is_regular_file(candidate, fileEc)) archives.push_back(candidate);
+			}
+			auto lowerName = [](const std::filesystem::path &path) {
+				std::string name = path.filename().string();
+				for (char &ch : name) ch = (char)std::tolower((unsigned char)ch);
+				return name;
+			};
+			auto rank = [&lowerName](const std::filesystem::path &path) {
+				const std::string name = lowerName(path);
+				if (name.rfind("patch", 0) == 0) return 2;   // applied last (wins)
+				if (name == "data.xp3") return 0;            // base data first
+				return 1;
+			};
+			std::sort(archives.begin(), archives.end(),
+			          [&](const std::filesystem::path &a, const std::filesystem::path &b) {
+				          const int ra = rank(a), rb = rank(b);
+				          if (ra != rb) return ra < rb;
+				          return lowerName(a) < lowerName(b);
+			          });
+			for (const auto &archive : archives) {
+				std::string name = archive.string() + ">";
+				tjs_string wide;
+				TVPUtf8ToUtf16(wide, name);
+				try {
+					TVPAddAutoPath(ttstr(wide));
+					TVPLOG_INFO("OEP: mounted archive {}", name);
+				} catch (...) {
+					TVPLOG_WARNING("OEP: could not mount archive {}", name);
+				}
+			}
+		}
+	}
+#endif
