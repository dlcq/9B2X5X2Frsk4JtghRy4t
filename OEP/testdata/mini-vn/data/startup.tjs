// OEP test data - original, all ages, written for engine validation.
//
// It exercises the parts OEP integrates: Window/Layer drawing, the timer, touch
// and keyboard input, and audio output.  No third-party assets are used; the
// tone is generated by build-testdata.py.
//
// Controls
//   tap / click      : count a press and play a short tone
//   two finger tap   : ESC (the engine maps this to "back")
//   ESC              : quit the engine (session ends)

class OepTestWindow extends Window
{
	var background;
	var hud;
	var timer;
	var se;
	var ticks = 0;
	var taps = 0;
	var elapsedMs = 0;

	function OepTestWindow()
	{
		super.Window();
		setInnerSize(960, 540);

		background = new Layer(this, null);
		background.setSize(960, 540);
		add(background);

		// A Window has exactly one primary layer (parent == null).  Everything
		// else must be a child, otherwise the engine's layer-manager bookkeeping
		// fails with an internal error.
		hud = new Layer(this, background);
		hud.setSize(960, 540);
		hud.type = ltAlpha;      // transparent child layer (cleared every frame)
		hud.font.height = 20;
		add(hud);

		se = new WaveSoundBuffer(this);
		try {
			se.open("se.wav");
		} catch (e) {
			se = void;
		}

		timer = new Timer(this, "onTick");
		timer.interval = 1000 \ 30;
		timer.enabled = true;

		draw();
	}

	function draw()
	{
		var w = 960, h = 540;

		background.fillRect(0, 0, w, h, 0xff090a0f);
		for (var i = 0; i < 18; i++) {
			var t = i / 17.0;
			var r = 16 + int(26 * t);
			var g = 16 + int(24 * t);
			var b = 38 + int(74 * t);
			background.fillRect(0, i * 30, w, 30, 0xff000000 | (r << 16) | (g << 8) | b);
		}
		background.fillRect(0, 468, w, 2, 0xff9b7bff);
		background.fillRect(0, 470, w, 1, 0xff282e3d);

		var x = (ticks * 7) % (w + 200) - 100;
		background.fillRect(x, 372, 200, 64, 0xff9b7bff);
		background.fillRect(x + 10, 382, 180, 44, 0xff1b2030);

		hud.fillRect(0, 0, w, h, 0);
		hud.drawText(48, 40, "OEP engine test", 0xf4f4f8, 255);
		hud.drawText(48, 74, "KiriKiri Z / TJS2 / SDL3 - self-made all-ages data", 0x969baa, 255);
		hud.drawText(48, 126, "taps    : " + taps, 0x76bfff, 255);
		hud.drawText(48, 154, "ticks   : " + ticks, 0x76bfff, 255);
		hud.drawText(48, 182, "elapsed : " + (elapsedMs \ 1000) + " s", 0x76bfff, 255);
		hud.drawText(48, 238, "tap / click      : count and play a tone", 0x969baa, 255);
		hud.drawText(48, 266, "two finger tap   : ESC (back)", 0x969baa, 255);
		hud.drawText(48, 294, "ESC              : quit", 0x969baa, 255);
	}

	function onTick()
	{
		ticks++;
		elapsedMs += timer.interval;
		if (ticks % 2 == 0) draw();
	}

	function onMouseDown(x, y, button, shift)
	{
		super.onMouseDown(x, y, button, shift);
		taps++;
		if (se !== void) {
			se.stop();
			se.play();
		}
		draw();
	}

	function onKeyDown(key, shift, process)
	{
		if (key == VK_ESCAPE) {
			System.exit();
			return;
		}
		super.onKeyDown(key, shift, process);
	}
}

var oepWindow = new OepTestWindow();
oepWindow.visible = true;
